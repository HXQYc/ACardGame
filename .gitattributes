# Keep text consistent across Windows and Linux.
* text=auto
*.md text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cpp text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.json text eol=lf
*.gd text eol=lf
*.godot text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.cfg text eol=lf
*.uid text eol=lf
*.import text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary source assets must be preserved unchanged.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
